# Local PostgreSQL development owner. Choose your own nonempty password; never commit .env.
POSTGRES_USER=ledgerflow
POSTGRES_DB=ledgerflow
POSTGRES_PASSWORD=replace-with-a-local-password
# Host-run backend reads these environment variables (Compose uses POSTGRES_* above).
DB_URL=jdbc:postgresql://localhost:5432/ledgerflow
DB_USERNAME=ledgerflow
DB_PASSWORD=replace-with-the-same-local-password
# Backend listen port, default 8080.
PORT=8080
