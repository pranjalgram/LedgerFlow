# Local PostgreSQL development owner. Choose your own nonempty password; never commit .env.
POSTGRES_USER=ledgerflow_migrator
POSTGRES_DB=ledgerflow
# Change host port if PostgreSQL is already installed; also update DB_URL.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace-with-a-local-password
APP_DB_PASSWORD=replace-with-a-different-runtime-password
# Host-run backend reads these environment variables (Compose uses POSTGRES_* above).
DB_URL=jdbc:postgresql://localhost:5432/ledgerflow
DB_USERNAME=ledgerflow_app
DB_PASSWORD=replace-with-the-runtime-password
DB_MIGRATION_USERNAME=ledgerflow_migrator
DB_MIGRATION_PASSWORD=replace-with-the-migration-password
# Backend listen port, default 8080.
PORT=8080
# Generate local RSA keys with: java scripts/GenerateDevKeys.java (from repository root).
# Paths below are relative to backend/ when using gradlew bootRun.
JWT_PRIVATE_KEY=file:../.local-secrets/jwt-private.pem
JWT_PUBLIC_KEY=file:../.local-secrets/jwt-public.pem
JWT_ISSUER=urn:ledgerflow:local
# Start docker compose --profile events up -d before enabling asynchronous delivery.
EVENTS_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Start the events infrastructure profile for Redis; disable only for trusted local development.
RATE_LIMIT_ENABLED=true
# Generated OpenAPI and Swagger UI are opt-in for local developer use.
API_DOCS_ENABLED=false

# Webhook worker: explicit operator-approved origins, including ports. See docs/WEBHOOKS.md.
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_ALLOWED_ORIGINS=
WEBHOOK_ALLOW_LOCAL=false

# Optional protected metrics and OTLP traces. Generate local credentials with GenerateObservabilitySecrets.java.
METRICS_PASSWORD=
TRACING_EXPORT_ENABLED=false
TRACING_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
